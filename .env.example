# Copy the Transaction pooler connection string from Supabase > Connect.
# Keep this file private; never commit your real .env or database password.
DATABASE_URL=replace-with-your-supabase-transaction-pooler-url
# Only needed to run database migrations locally; use the Session pooler URL.
DIRECT_URL=replace-with-your-supabase-session-pooler-url
# Optional: choose another host port if 3000 is already in use.
FRONTEND_PORT=3000
# Small pool per local backend; use 2 when connecting through Supabase pooler.
DB_POOL_MAX=2
# Optional shared Redis for seat locks across machines. Leave blank for local Redis.
REDIS_URL=
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional local sandbox gateway credentials. Leave blank to disable real payments.
