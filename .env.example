# ==========================================
# DATABASE - Supabase PostgreSQL (bắt buộc)
# ==========================================
# Copy Transaction pooler URL từ Supabase > Connect.
# PHẢI là postgresql:// ... Dùng cho toàn bộ truy vấn (node-postgres "pg").
DIRECT_URL=postgresql://postgres.uhoznqcpaasartfvdynx:huyvinh123a@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=verify-full
DATABASE_URL=postgresql://postgres.uhoznqcpaasartfvdynx:huyvinh123a@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
 Supabase pooler.
DB_POOL_MAX=2

# ==========================================
# APPLICATION
# ==========================================
# Cổng API cố định là 5000 (khớp Dockerfile, nginx.conf, vercel.json).
PORT=5000
NODE_ENV=development
# Danh sách origin ngăn cách bởi dấu phẩy, KHÔNG có khoảng trắng thừa.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# JWT_SECRET: chuỗi ngẫu nhiên >= 32 ký tự (sinh ở README).
JWT_SECRET=+beF0dLil2sJvf2AV8VLLnxzaxLa82Gc2uMnw4PznkE=
# debug | info | warn | error
LOG_LEVEL=info

# ==========================================
# REDIS - khoá ghế tạm 10 phút (không bắt buộc)
# ==========================================
# Để trống = TẮT khoá Redis, chỉ dùng khoá dòng PostgreSQL trong
# services/booking.ts. Đây là hành vi ĐÚNG, không phải lỗi.
# Muốn bật khoá phân tán giữa nhiều máy: docker compose up -d redis
# rồi đặt REDIS_URL=redis://localhost:6379
REDIS_URL=
# Hoặc dùng bộ ba biến riêng (ưu tiên REDIS_URL nếu có cả hai):
# REDIS_HOST=localhost
# REDIS_PORT=6379
# ==========================================
# PAYMENT GATEWAYS - VNPay / MoMo sandbox
# ==========================================
# Bỏ trống nhóm này để TẮT thanh toán online (chỉ còn tiền mặt tại xe).
#
# ⚠️ QUAN TRỌNG - WEBHOOK KHÔNG DÙNG ĐƯỢC LOCALHOST:
# VNPay/MoMo là máy chủ bên ngoài gọi vào máy bạn, nên localhost chỉ dùng
# để gọi tay bằng Postman/curl. Muốn nhận IPN thật, dùng URL public:
#   - ngrok:    ngrok http 5000        -> https://xxxx.ngrok-free.app
#   - cloudflared: cloudflared tunnel --url http://localhost:5000
#   - hoặc domain Vercel đã deploy
# rồi đặt PAYMENT_PUBLIC_BASE_URL và đăng ký IPN trên cổng thanh toán.
#
# PAYMENT_PUBLIC_BASE_URL: gốc public của API, KHÔNG có dấu / ở cuối.
# Để trống sẽ tự suy ra từ VERCEL_URL, hoặc localhost:PORT khi chạy local.
PAYMENT_PUBLIC_BASE_URL=

# Callback của VNPay (return = trình duyệt, ipn = máy chủ gọi nền).
# Hai URL phải trỏ đúng route đang chạy:
#   /api/v1/ticketing/payments/vnpay/return
#   /api/v1/ticketing/payments/vnpay/ipn
# (API cũng chấp nhận alias gạch ngang vnpay-return / vnpay-ipn)
VNPAY_RETURN_URL=
VNPAY_IPN_URL=
VNPAY_TMN_CODE=H4NLY7LW
VNPAY_HASH_SECRET=CPYQJEBPRNTZQSZPKQCBOAWLSOPJKFUF
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_REFUND_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# Callback của MoMo (gửi trong payload, nên bắt buộc URL public).
MOMO_IPN_URL=
MOMO_REDIRECT_URL=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_CREATE_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REFUND_URL=https://test-payment.momo.vn/v2/gateway/api/refund

# ==========================================
# PAYMENT OPERATIONS
# ==========================================
# Trang frontend hiển thị kết quả thanh toán.
PAYMENT_RESULT_URL=http://localhost:3000/passenger/booking
# IP gửi lên cổng thanh toán. MoMo yêu cầu IP public, KHÔNG phải localhost.
PAYMENT_CLIENT_IP=127.0.0.1
PAYMENT_REFUND_OPERATOR=smartbus-system
PAYMENT_REFUND_IP=127.0.0.1
# Bearer token cho endpoint /release-expired. Bắt buộc ở production.
PAYMENT_CRON_SECRET=
# Cho phép đổi cổng frontend trong Docker Compose nếu cổng 3000 đã bận.
FRONTEND_PORT=3000
# REDIS_PASSWORD=
