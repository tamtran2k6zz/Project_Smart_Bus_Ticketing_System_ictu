datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RouteStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum FareType {
  FLAT_FARE
  STAGE_FARE
}

enum TicketType {
  SINGLE
  MONTHLY_STUDENT
  MONTHLY_REGULAR
  PRIORITY
}

enum TripStatus {
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum TicketStatus {
  RESERVED
  BOOKED
  CANCELLED
}

model Route {
  id                   String      @id @default(uuid()) @db.Char(36)
  code                 String      @unique(map: "uq_routes_code") @db.VarChar(50)
  name                 String      @db.VarChar(255)
  description          String?     @db.VarChar(255)
  distanceKm           Float       @default(0.0) @map("distance_km")
  estimatedDurationMin Int         @default(0) @map("estimated_duration_min")
  status               RouteStatus @default(DRAFT)
  deletedAt            DateTime?   @map("deleted_at") @db.DateTime(3)
  createdAt            DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  routeStops RouteStop[]
  fares      Fare[]
  trips      Trip[]

  @@index([status])
  @@index([deletedAt])
  @@map("routes")
}

model BusStop {
  id        String    @id @default(uuid()) @db.Char(36)
  code      String    @unique(map: "bus_stops_code_key") @db.VarChar(50)
  name      String    @db.VarChar(255)
  address   String    @default("") @db.VarChar(255)
  latitude  Float
  longitude Float
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  routeStops RouteStop[]
  fromFares  Fare[]      @relation("FareFromStop")
  toFares    Fare[]      @relation("FareToStop")

  @@index([latitude, longitude])
  @@index([deletedAt])
  @@index([isActive])
  @@map("bus_stops")
}

model RouteStop {
  id                        String   @id @default(uuid()) @db.Char(36)
  routeId                   String   @map("route_id") @db.Char(36)
  stopId                    String   @map("stop_id") @db.Char(36)
  stopOrder                 Int      @map("stop_order")
  distanceFromStartKm       Float    @default(0.0) @map("distance_from_start_km")
  estimatedMinutesFromStart Int      @default(0) @map("estimated_time_minutes")
  isTerminal                Boolean  @default(false) @map("is_terminal")
  createdAt                 DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  route Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop  BusStop @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@unique([routeId, stopId], name: "unique_route_stop", map: "uq_route_stops_route_stop")
  @@unique([routeId, stopOrder], name: "unique_route_order", map: "uq_route_stops_route_order")
  @@index([stopId, routeId, stopOrder, estimatedMinutesFromStart], name: "idx_route_stops_search_covering")
  @@index([routeId, stopOrder], name: "idx_route_stops_route_order")
  @@map("route_stops")
}

model Bus {
  id          String   @id @default(uuid()) @db.Char(36)
  plateNumber String   @unique(map: "uq_buses_plate_number") @map("plate_number") @db.VarChar(20)
  busType     String   @map("bus_type") @db.VarChar(50)
  totalSeats  Int      @map("total_seats")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  trips Trip[]

  @@map("buses")
}

model Trip {
  id            String     @id @default(uuid()) @db.Char(36)
  routeId       String     @map("route_id") @db.Char(36)
  busId         String     @map("bus_id") @db.Char(36)
  departureTime DateTime   @map("departure_time") @db.DateTime(3)
  arrivalTime   DateTime   @map("arrival_time") @db.DateTime(3)
  status        TripStatus @default(SCHEDULED)
  basePrice     Decimal    @map("base_price") @db.Decimal(12, 2)
  createdAt     DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  route    Route     @relation(fields: [routeId], references: [id], onDelete: Restrict)
  bus      Bus       @relation(fields: [busId], references: [id], onDelete: Restrict)
  bookings Booking[]
  tickets  Ticket[]

  @@index([routeId, status, departureTime], name: "idx_trips_route_status_departure")
  @@index([status, departureTime])
  @@map("trips")
}

model Booking {
  id          String        @id @default(uuid()) @db.Char(36)
  tripId      String        @map("trip_id") @db.Char(36)
  bookingCode String        @unique(map: "uq_bookings_booking_code") @map("booking_code") @db.VarChar(50)
  status      BookingStatus @default(PENDING)
  totalAmount Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)
  createdAt   DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  trip    Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@index([tripId, status], name: "idx_bookings_trip_status")
  @@map("bookings")
}

model Ticket {
  id         String       @id @default(uuid()) @db.Char(36)
  bookingId  String       @map("booking_id") @db.Char(36)
  tripId     String       @map("trip_id") @db.Char(36)
  seatNumber String       @map("seat_number") @db.VarChar(10)
  price      Decimal      @db.Decimal(12, 2)
  status     TicketStatus @default(RESERVED)
  createdAt  DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  trip    Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, status], name: "idx_tickets_trip_status")
  @@map("tickets")
}

model Fare {
  id            String     @id @default(uuid()) @db.Char(36)
  routeId       String     @map("route_id") @db.Char(36)
  fareType      FareType   @default(FLAT_FARE)
  ticketType    TicketType @default(SINGLE) @map("ticket_type")
  amount        Float
  fromStopId    String?    @map("from_stop_id") @db.Char(36)
  toStopId      String?    @map("to_stop_id") @db.Char(36)
  effectiveFrom DateTime   @default(now()) @map("effective_from") @db.DateTime(3)
  effectiveTo   DateTime?  @map("effective_to") @db.DateTime(3)
  isActive      Boolean    @default(true) @map("is_active")
  deletedAt     DateTime?  @map("deleted_at") @db.DateTime(3)
  createdAt     DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  route    Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  fromStop BusStop? @relation("FareFromStop", fields: [fromStopId], references: [id], onDelete: SetNull)
  toStop   BusStop? @relation("FareToStop", fields: [toStopId], references: [id], onDelete: SetNull)

  @@index([routeId])
  @@index([fareType])
  @@index([deletedAt])
  @@map("fares")
}
