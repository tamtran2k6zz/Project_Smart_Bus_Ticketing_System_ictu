// PostgreSQL data model for the deployed Express API.
//
// This file mirrors supabase/migrations/*.sql, which remain the single source
// of truth for the DDL. Apply them with `npm run db:migrate`
// (backend/scripts/migrate-postgres.cjs). Do NOT run `prisma migrate` against
// Supabase: this folder intentionally holds no Prisma migration history.
//
// Every model maps to a real Supabase table through @@map(), and every field
// maps to a real column through @map(). Identifiers are text/timestamptz and
// columns are snake_case, exactly as created by the SQL migrations.
//
// Database: Supabase PostgreSQL. Never point this at MySQL.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum FareType {
  FLAT_FARE
  STAGE_FARE
}

enum TicketType {
  SINGLE
  MONTHLY_STUDENT
  MONTHLY_REGULAR
  PRIORITY
}

enum TripStatus {
  SCHEDULED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  RESERVED
  BOOKED
  CHECKED_IN
  CANCELLED
}

enum SeatStatus {
  AVAILABLE
  LOCKED
  BOOKED
  CHECKED_IN
}

enum PaymentMethodCode {
  VNPAY
  MOMO
}

enum PaymentStatusCode {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  users       User[]

  @@map("roles")
}

model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()::text"))
  fullName       String    @map("full_name") @db.VarChar(100)
  email          String    @unique @db.VarChar(100)
  phoneNumber    String?   @unique(map: "users_phone_unique") @map("phone_number") @db.VarChar(20)
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  roleId         Int       @map("role_id")
  role           String    @default("PASSENGER") @db.VarChar(20)
  status         String    @default("ACTIVE") @db.VarChar(20)
  discountType   String    @default("NONE") @map("discount_type") @db.VarChar(20)
  discountStatus String    @default("NOT_REGISTERED") @map("discount_status") @db.VarChar(30)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  roleRef        Role      @relation(fields: [roleId], references: [id], onDelete: Restrict, map: "fk_users_role")
  trips          Trip[]
  tickets        Ticket[]
  feedbacks      Feedback[]
  incidents      Incident[]
  seatLocks      TripSeat[]

  @@index([roleId], map: "users_role_idx")
  @@map("users")
}

model Route {
  id                   String     @id @default(dbgenerated("gen_random_uuid()::text"))
  code                 String     @unique @db.VarChar(20)
  name                 String     @db.VarChar(150)
  description          String?    @db.Text
  distanceKm           Decimal?   @default(0) @map("distance_km") @db.Decimal(6, 2)
  basePrice            Decimal    @default(10000) @map("base_price") @db.Decimal(10, 2)
  estimatedDurationMin Int        @default(0) @map("estimated_duration_min")
  status               String     @default("ACTIVE") @db.VarChar(20)
  deletedAt            DateTime?  @map("deleted_at") @db.Timestamptz(3)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime   @default(now()) @map("updated_at") @db.Timestamptz(3)
  trips                Trip[]
  routeStops           RouteStop[]
  fares                Fare[]

  @@map("routes")
}

model BusStop {
  id        String      @id @default(dbgenerated("gen_random_uuid()::text"))
  code      String      @unique @db.VarChar(20)
  name      String      @db.VarChar(150)
  address   String?     @db.VarChar(255)
  latitude  Decimal?    @db.Decimal(10, 7)
  longitude Decimal?    @db.Decimal(10, 7)
  isActive  Boolean     @default(true) @map("is_active")
  deletedAt DateTime?   @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  routeStops RouteStop[]

  @@map("bus_stops")
}

model RouteStop {
  id                   String  @id @default(dbgenerated("gen_random_uuid()::text"))
  routeId              String  @map("route_id")
  stopId               String  @map("stop_id")
  stopOrder            Int     @map("stop_order")
  distanceFromStartKm  Decimal @default(0) @map("distance_from_start_km") @db.Decimal(6, 2)
  estimatedTimeMinutes Int     @default(0) @map("estimated_time_minutes")
  route                Route   @relation(fields: [routeId], references: [id], onDelete: Cascade, map: "fk_rs_route")
  stop                 BusStop @relation(fields: [stopId], references: [id], onDelete: Cascade, map: "fk_rs_stop")

  @@unique([routeId, stopOrder], map: "uq_route_stop_order")
  @@index([routeId, stopOrder], map: "idx_route_stops_order")
  @@index([stopId], map: "route_stops_stop_idx")
  @@map("route_stops")
}
model Bus {
  id               String   @id
  plateNumber      String   @unique @map("plate_number") @db.VarChar(20)
  busType          String?  @default("STANDARD") @map("bus_type") @db.VarChar(50)
  totalSeats       Int      @default(40) @map("total_seats")
  standingCapacity Int      @default(15) @map("standing_capacity")
  status           String?  @default("READY") @db.VarChar(50)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  seats            Seat[]
  trips            Trip[]

  @@map("buses")
}

model Seat {
  id          String     @id
  busId       String     @map("bus_id")
  seatNumber  String     @map("seat_number") @db.VarChar(10)
  seatType    String?    @default("STANDARD") @map("seat_type") @db.VarChar(20)
  rowPosition String?    @default("WINDOW") @map("row_position") @db.VarChar(20)
  deck        String?    @default("DECK_1") @db.VarChar(20)
  isPriority  Boolean    @default(false) @map("is_priority")
  status      String?    @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @default(now()) @map("updated_at") @db.Timestamptz(3)
  bus         Bus        @relation(fields: [busId], references: [id], onDelete: Cascade, map: "fk_seats_bus")
  tripSeats   TripSeat[]

  @@unique([busId, seatNumber], map: "uq_seats_bus_seat_number")
  @@index([busId], map: "idx_seats_bus_id")
  @@map("seats")
}

model Fare {
  id         String     @id
  routeId    String     @map("route_id")
  fareType   FareType   @default(FLAT_FARE) @map("fare_type")
  ticketType TicketType @default(SINGLE) @map("ticket_type")
  amount     Decimal    @db.Decimal(12, 2)
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  route      Route      @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@map("fares")
}

model Trip {
  id            String     @id @default(dbgenerated("gen_random_uuid()::text"))
  routeId       String     @map("route_id")
  busId         String?    @map("bus_id")
  busPlate      String?    @map("bus_plate") @db.VarChar(20)
  driverId      String?    @map("driver_id")
  departureTime DateTime   @map("departure_time") @db.Timestamptz(3)
  arrivalTime   DateTime   @map("arrival_time") @db.Timestamptz(3)
  totalSeats    Int        @default(40) @map("total_seats")
  bookedSeats   Int        @default(0) @map("booked_seats")
  basePrice     Decimal    @default(10000) @map("base_price") @db.Decimal(10, 2)
  status        TripStatus @default(SCHEDULED)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  route         Route      @relation(fields: [routeId], references: [id], onDelete: Cascade, map: "fk_trips_route")
  bus           Bus?       @relation(fields: [busId], references: [id], onDelete: Restrict)
  driver        User?      @relation(fields: [driverId], references: [id], onDelete: SetNull, map: "fk_trips_driver")
  tickets       Ticket[]
  tripSeats     TripSeat[]
  incidents     Incident[]
  feedbacks     Feedback[]

  @@index([routeId, departureTime], map: "idx_trips_route_departure")
  @@index([busId], map: "trips_bus_idx")
  @@index([driverId], map: "trips_driver_idx")
  @@map("trips")
}

model Ticket {
  id                   String       @id
  ticketCode           String?      @unique @map("ticket_code") @db.VarChar(50)
  tripId               String       @map("trip_id")
  status               TicketStatus @default(BOOKED)
  seatNumber           String?      @map("seat_number") @db.VarChar(10)
  userId               String?      @map("user_id")
  fareAmount           Decimal      @default(10000) @map("fare_amount") @db.Decimal(10, 2)
  reservationExpiresAt DateTime?    @map("reservation_expires_at") @db.Timestamptz(3)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  trip                 Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade, map: "fk_tickets_trip")
  user                 User?        @relation(fields: [userId], references: [id], onDelete: SetNull, map: "fk_tickets_user")
  tripSeats            TripSeat[]
  payment              PaymentTransaction?

  @@index([userId], map: "tickets_user_idx")
  @@map("tickets")
}

model TripSeat {
  id             String     @id @default(dbgenerated("gen_random_uuid()::text"))
  tripId         String     @map("trip_id")
  seatId         String?    @map("seat_id")
  seatNumber     String     @map("seat_number") @db.VarChar(10)
  status         SeatStatus @default(AVAILABLE)
  lockedAt       DateTime?  @map("locked_at") @db.Timestamptz(3)
  lockedByUserId String?    @map("locked_by_user_id")
  lockExpiresAt  DateTime?  @map("lock_expires_at") @db.Timestamptz(3)
  ticketId       String?    @map("ticket_id")
  redisLockId    String?    @map("redis_lock_id")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @default(now()) @map("updated_at") @db.Timestamptz(3)
  trip           Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade, map: "fk_trip_seats_trip")
  seat           Seat?      @relation(fields: [seatId], references: [id], onDelete: SetNull, map: "fk_trip_seats_seat")
  lockedByUser   User?      @relation(fields: [lockedByUserId], references: [id], onDelete: SetNull, map: "fk_trip_seats_user")
  ticket         Ticket?    @relation(fields: [ticketId], references: [id], onDelete: SetNull, map: "fk_trip_seats_ticket")

  @@unique([tripId, seatNumber], map: "uq_trip_seats_trip_number")
  @@index([tripId, status], map: "idx_trip_seats_trip_status")
  @@index([lockExpiresAt], map: "idx_trip_seats_lock_expires")
  @@index([seatId], map: "trip_seats_seat_idx")
  @@index([lockedByUserId], map: "trip_seats_user_idx")
  @@index([ticketId], map: "trip_seats_ticket_idx")
  @@map("trip_seats")
}

model Incident {
  id           String   @id @default(dbgenerated("gen_random_uuid()::text"))
  tripId       String   @map("trip_id")
  driverId     String?  @map("driver_id")
  incidentType String   @map("incident_type") @db.VarChar(50)
  severity     String?  @default("MEDIUM") @db.VarChar(20)
  description  String   @db.Text
  delayMinutes Int      @default(0) @map("delay_minutes")
  actionTaken  String?  @map("action_taken") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  trip         Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade, map: "fk_incidents_trip")
  driver       User?    @relation(fields: [driverId], references: [id], onDelete: SetNull, map: "fk_incidents_driver")

  @@index([tripId], map: "incidents_trip_idx")
  @@map("incidents")
}

model Feedback {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  tripId      String   @map("trip_id")
  userId      String?  @map("user_id")
  ratingStars Int      @map("rating_stars")
  criteria    String?  @db.VarChar(100)
  content     String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade, map: "fk_feedbacks_trip")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull, map: "fk_feedbacks_user")

  @@map("feedbacks")
}

/// One row per ticket handed to an online gateway.
///
/// There is no separate "bookings" or "payments" table: the ticket id doubles
/// as order_id (services/booking.ts inserts both from the same UUID). That is
/// why vnp_TxnRef and the MoMo orderId must be the UUID returned as
/// payment.orderId by POST /api/v1/ticketing/bookings, never a value such as
/// "ORD-20261002-001".
model PaymentTransaction {
  id                   String             @id @default(dbgenerated("gen_random_uuid()::text"))
  ticketId             String             @unique @map("ticket_id")
  orderId              String             @unique @map("order_id")
  paymentMethod        PaymentMethodCode  @map("payment_method")
  amount               Decimal            @db.Decimal(12, 2)
  status               PaymentStatusCode
  gatewayTransactionId String?            @map("gateway_transaction_id")
  refundRequestId      String?            @unique @map("refund_request_id")
  redisLockId          String?            @map("redis_lock_id")
  paidAt               DateTime?          @map("paid_at") @db.Timestamptz(3)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  ticket               Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([status], map: "idx_payment_transactions_status")
  @@map("payment_transactions")
}