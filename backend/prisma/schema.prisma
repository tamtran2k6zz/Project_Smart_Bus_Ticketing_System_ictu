datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  MANAGER
  DRIVER
  PASSENGER
}

enum DiscountType {
  NONE
  STUDENT
  ELDERLY
  PRIORITY
}

enum DiscountStatus {
  NOT_REGISTERED
  PENDING
  APPROVED
  REJECTED
}

enum UserStatus {
  ACTIVE
  LOCKED
}

enum RouteStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum FareType {
  FLAT_FARE
  STAGE_FARE
}

enum TicketType {
  SINGLE
  MONTHLY_STUDENT
  MONTHLY_REGULAR
  PRIORITY
}

enum TripStatus {
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum TicketStatus {
  RESERVED
  BOOKED
  CHECKED_IN
  CANCELLED
}

enum TripSeatStatus {
  AVAILABLE
  HELD
  BOOKED
  BLOCKED
}

enum PaymentMethod {
  MOMO
  VNPAY
  ZALOPAY
  BANK_TRANSFER
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum MonthlyPassType {
  STUDENT
  REGULAR
  ALL_ROUTES
}

enum PassStatus {
  ACTIVE
  EXPIRED
  LOCKED
}

enum VoucherStatus {
  ACTIVE
  EXPIRED
  PAUSED
}

enum IncidentType {
  TRAFFIC_JAM
  BREAKDOWN
  BAD_WEATHER
  ACCIDENT
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
}

enum FeedbackStatus {
  PENDING
  PROCESSING
  RESOLVED
}

enum NotificationType {
  APPROACHING_STOP
  SCHEDULE_CHANGE
  CANCELLED_TRIP
  PROMOTION
  SYSTEM
}

model User {
  id               String         @id @default(uuid()) @db.VarChar(36)
  fullName         String         @map("full_name") @db.VarChar(255)
  email            String         @unique(map: "uq_users_email") @db.VarChar(191)
  phoneNumber      String?        @unique(map: "uq_users_phone") @map("phone_number") @db.VarChar(50)
  passwordHash     String         @map("password_hash") @db.VarChar(255)
  role             UserRole       @default(PASSENGER)
  discountType     DiscountType   @default(NONE) @map("discount_type")
  discountStatus   DiscountStatus @default(NOT_REGISTERED) @map("discount_status")
  discountProofUrl String?        @map("discount_proof_url") @db.VarChar(500)
  status           UserStatus     @default(ACTIVE)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  driverTrips     Trip[]           @relation("TripDriver")
  assistantTrips  Trip[]           @relation("TripAssistant")
  bookings        Booking[]
  tickets         Ticket[]
  monthlyPasses   MonthlyPass[]
  feedbacks       Feedback[]
  incidentReports IncidentReport[]
  notifications   Notification[]
  activityLogs    ActivityLog[]

  @@map("users")
}

model Route {
  id                   String      @id @default(uuid()) @db.VarChar(36)
  code                 String      @unique(map: "uq_routes_code") @db.VarChar(50)
  name                 String      @db.VarChar(255)
  description          String?     @db.Text
  distanceKm           Float       @default(0.0) @map("distance_km")
  estimatedDurationMin Int         @default(0) @map("estimated_duration_min")
  status               RouteStatus @default(DRAFT)
  deletedAt            DateTime?   @map("deleted_at")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  routeStops    RouteStop[]
  fares         Fare[]
  trips         Trip[]
  monthlyPasses MonthlyPass[]

  @@index([status])
  @@index([deletedAt])
  @@map("routes")
}

model BusStop {
  id        String    @id @default(uuid()) @db.VarChar(36)
  code      String    @unique(map: "bus_stops_code_key") @db.VarChar(50)
  name      String    @db.VarChar(255)
  address   String    @db.Text
  latitude  Float
  longitude Float
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  routeStops       RouteStop[]
  fromFares        Fare[]      @relation("FareFromStop")
  toFares          Fare[]      @relation("FareToStop")
  departureTickets Ticket[]    @relation("TicketFromStop")
  arrivalTickets   Ticket[]    @relation("TicketToStop")

  @@index([latitude, longitude])
  @@index([deletedAt])
  @@index([isActive])
  @@map("bus_stops")
}

model RouteStop {
  id                        String   @id @default(uuid()) @db.VarChar(36)
  routeId                   String   @map("route_id") @db.VarChar(36)
  stopId                    String   @map("stop_id") @db.VarChar(36)
  stopOrder                 Int      @map("stop_order")
  distanceFromStartKm       Float    @default(0.0) @map("distance_from_start_km")
  estimatedMinutesFromStart Int      @default(0) @map("estimated_time_minutes")
  isTerminal                Boolean  @default(false) @map("is_terminal")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  route Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop  BusStop @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@unique([routeId, stopId], name: "unique_route_stop", map: "uq_route_stops_route_stop")
  @@unique([routeId, stopOrder], name: "unique_route_order", map: "uq_route_stops_route_order")
  @@index([stopId, routeId, stopOrder, estimatedMinutesFromStart], name: "idx_route_stops_search_covering")
  @@index([routeId, stopOrder], name: "idx_route_stops_route_order")
  @@map("route_stops")
}

model Bus {
  id               String   @id @default(uuid()) @db.VarChar(36)
  plateNumber      String   @unique(map: "uq_buses_plate_number") @map("plate_number") @db.VarChar(20)
  busType          String   @map("bus_type") @db.VarChar(50)
  totalSeats       Int      @map("total_seats")
  standingCapacity Int      @default(15) @map("standing_capacity")
  currentLatitude  Float?   @map("current_latitude")
  currentLongitude Float?   @map("current_longitude")
  status           String   @default("READY") @db.VarChar(50)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  trips Trip[]
  seats Seat[]

  @@map("buses")
}

model Seat {
  id          String   @id @default(uuid()) @db.VarChar(36)
  busId       String   @map("bus_id") @db.VarChar(36)
  seatNumber  String   @map("seat_number") @db.VarChar(10)
  rowPosition String   @default("WINDOW") @map("row_position") @db.VarChar(20)
  deck        String   @default("DECK_1") @db.VarChar(20)
  isPriority  Boolean  @default(false) @map("is_priority")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  bus       Bus        @relation(fields: [busId], references: [id], onDelete: Cascade)
  tickets   Ticket[]
  tripSeats TripSeat[]

  @@unique([busId, seatNumber], name: "uq_bus_seat_number")
  @@map("seats")
}

model TripSeat {
  id        String         @id @default(uuid()) @db.VarChar(36)
  tripId    String         @map("trip_id") @db.VarChar(36)
  seatId    String         @map("seat_id") @db.VarChar(36)
  status    TripSeatStatus @default(AVAILABLE)
  bookingId String?        @map("booking_id") @db.VarChar(36)
  lockedAt  DateTime?      @map("locked_at")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  trip    Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  seat    Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([tripId, seatId], name: "uq_trip_seat")
  @@index([tripId, status], name: "idx_trip_seats_trip_status")
  @@index([seatId])
  @@map("trip_seats")
}

model Trip {
  id                  String     @id @default(uuid()) @db.VarChar(36)
  routeId             String     @map("route_id") @db.VarChar(36)
  busId               String     @map("bus_id") @db.VarChar(36)
  driverId            String?    @map("driver_id") @db.VarChar(36)
  assistantId         String?    @map("assistant_id") @db.VarChar(36)
  departureTime       DateTime   @map("departure_time")
  arrivalTime         DateTime   @map("arrival_time")
  actualDepartureTime DateTime?  @map("actual_departure_time")
  actualArrivalTime   DateTime?  @map("actual_arrival_time")
  status              TripStatus @default(SCHEDULED)
  basePrice           Decimal    @map("base_price") @db.Decimal(12, 2)
  dispatchNotes       String?    @map("dispatch_notes") @db.Text
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  route           Route            @relation(fields: [routeId], references: [id], onDelete: Restrict)
  bus             Bus              @relation(fields: [busId], references: [id], onDelete: Restrict)
  driver          User?            @relation("TripDriver", fields: [driverId], references: [id], onDelete: SetNull)
  assistant       User?            @relation("TripAssistant", fields: [assistantId], references: [id], onDelete: SetNull)
  bookings        Booking[]
  tickets         Ticket[]
  tripSeats       TripSeat[]
  incidentReports IncidentReport[]
  feedbacks       Feedback[]

  @@index([routeId, status, departureTime], name: "idx_trips_route_status_departure")
  @@index([status, departureTime])
  @@map("trips")
}

model Booking {
  id          String        @id @default(uuid()) @db.VarChar(36)
  tripId      String        @map("trip_id") @db.VarChar(36)
  userId      String?       @map("user_id") @db.VarChar(36)
  bookingCode String        @unique(map: "uq_bookings_booking_code") @map("booking_code") @db.VarChar(50)
  status      BookingStatus @default(PENDING)
  totalAmount Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  trip      Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  tickets   Ticket[]
  payments  Payment[]
  tripSeats TripSeat[]

  @@index([tripId, status], name: "idx_bookings_trip_status")
  @@map("bookings")
}

model Ticket {
  id                   String       @id @default(uuid()) @db.VarChar(36)
  bookingId            String       @map("booking_id") @db.VarChar(36)
  tripId               String       @map("trip_id") @db.VarChar(36)
  userId               String?      @map("user_id") @db.VarChar(36)
  seatId               String?      @map("seat_id") @db.VarChar(36)
  seatNumber           String       @map("seat_number") @db.VarChar(10)
  fromStopId           String?      @map("from_stop_id") @db.VarChar(36)
  toStopId             String?      @map("to_stop_id") @db.VarChar(36)
  voucherId            String?      @map("voucher_id") @db.VarChar(36)
  ticketCode           String?      @unique(map: "uq_tickets_code") @map("ticket_code") @db.VarChar(50)
  qrCode               String?      @map("qr_code") @db.VarChar(500)
  price                Decimal      @db.Decimal(12, 2)
  status               TicketStatus @default(RESERVED)
  reservationExpiresAt DateTime?    @map("reservation_expires_at")
  checkedInAt          DateTime?    @map("checked_in_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  booking  Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  trip     Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  seat     Seat?     @relation(fields: [seatId], references: [id], onDelete: SetNull)
  fromStop BusStop?  @relation("TicketFromStop", fields: [fromStopId], references: [id], onDelete: SetNull)
  toStop   BusStop?  @relation("TicketToStop", fields: [toStopId], references: [id], onDelete: SetNull)
  voucher  Voucher?  @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([tripId, status], name: "idx_tickets_trip_status")
  @@map("tickets")
}

model Fare {
  id            String     @id @default(uuid()) @db.VarChar(36)
  routeId       String     @map("route_id") @db.VarChar(36)
  fareType      FareType   @default(FLAT_FARE)
  ticketType    TicketType @default(SINGLE) @map("ticket_type")
  amount        Float
  fromStopId    String?    @map("from_stop_id") @db.VarChar(36)
  toStopId      String?    @map("to_stop_id") @db.VarChar(36)
  effectiveFrom DateTime   @default(now()) @map("effective_from")
  effectiveTo   DateTime?  @map("effective_to")
  isActive      Boolean    @default(true) @map("is_active")
  deletedAt     DateTime?  @map("deleted_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  route    Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  fromStop BusStop? @relation("FareFromStop", fields: [fromStopId], references: [id], onDelete: SetNull)
  toStop   BusStop? @relation("FareToStop", fields: [toStopId], references: [id], onDelete: SetNull)

  @@index([routeId])
  @@index([fareType])
  @@index([deletedAt])
  @@map("fares")
}

model Payment {
  id                    String        @id @default(uuid()) @db.VarChar(36)
  bookingId             String?       @map("booking_id") @db.VarChar(36)
  ticketId              String?       @map("ticket_id") @db.VarChar(36)
  gatewayTransactionId  String?       @map("gateway_transaction_id") @db.VarChar(100)
  paymentMethod         PaymentMethod @default(VNPAY) @map("payment_method")
  amount                Decimal       @db.Decimal(12, 2)
  status                PaymentStatus @default(PENDING)
  electronicInvoiceCode String?       @map("electronic_invoice_code") @db.VarChar(100)
  invoiceEmail          String?       @map("invoice_email") @db.VarChar(191)
  paidAt                DateTime?     @map("paid_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ticket  Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model MonthlyPass {
  id        String          @id @default(uuid()) @db.VarChar(36)
  userId    String          @map("user_id") @db.VarChar(36)
  routeId   String          @map("route_id") @db.VarChar(36)
  cardCode  String          @unique(map: "uq_monthly_pass_code") @map("card_code") @db.VarChar(50)
  passType  MonthlyPassType @default(REGULAR) @map("pass_type")
  startDate DateTime        @map("start_date")
  endDate   DateTime        @map("end_date")
  price     Decimal         @db.Decimal(12, 2)
  status    PassStatus      @default(ACTIVE)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@map("monthly_passes")
}

model Voucher {
  id                String        @id @default(uuid()) @db.VarChar(36)
  code              String        @unique(map: "uq_vouchers_code") @db.VarChar(50)
  title             String        @db.VarChar(255)
  discountPercent   Float         @default(0) @map("discount_percent")
  maxDiscountAmount Decimal       @default(0) @map("max_discount_amount") @db.Decimal(12, 2)
  minOrderAmount    Decimal       @default(0) @map("min_order_amount") @db.Decimal(12, 2)
  startDate         DateTime      @map("start_date")
  endDate           DateTime      @map("end_date")
  usageLimit        Int           @default(100) @map("usage_limit")
  usedCount         Int           @default(0) @map("used_count")
  status            VoucherStatus @default(ACTIVE)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  tickets Ticket[]

  @@map("vouchers")
}

model IncidentReport {
  id           String           @id @default(uuid()) @db.VarChar(36)
  tripId       String           @map("trip_id") @db.VarChar(36)
  driverId     String           @map("driver_id") @db.VarChar(36)
  incidentType IncidentType     @default(OTHER) @map("incident_type")
  severity     IncidentSeverity @default(MEDIUM)
  description  String           @db.Text
  delayMinutes Int              @default(0) @map("delay_minutes")
  actionTaken  String?          @map("action_taken") @db.Text
  reportedAt   DateTime         @default(now()) @map("reported_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  trip   Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driver User @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("incident_reports")
}

model Feedback {
  id                String         @id @default(uuid()) @db.VarChar(36)
  userId            String         @map("user_id") @db.VarChar(36)
  tripId            String         @map("trip_id") @db.VarChar(36)
  ratingStars       Int            @default(5) @map("rating_stars")
  criteria          String?        @db.VarChar(100)
  content           String         @db.Text
  responseFromStaff String?        @map("response_from_staff") @db.Text
  status            FeedbackStatus @default(PENDING)
  submittedAt       DateTime       @default(now()) @map("submitted_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}

model Notification {
  id        String           @id @default(uuid()) @db.VarChar(36)
  userId    String           @map("user_id") @db.VarChar(36)
  title     String           @db.VarChar(255)
  content   String           @db.Text
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false) @map("is_read")
  sentAt    DateTime         @default(now()) @map("sent_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model ActivityLog {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String?  @map("user_id") @db.VarChar(36)
  action    String   @db.VarChar(100)
  module    String   @db.VarChar(50)
  ipAddress String?  @map("ip_address") @db.VarChar(50)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}
