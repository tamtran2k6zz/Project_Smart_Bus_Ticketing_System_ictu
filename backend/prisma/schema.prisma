datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RouteStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum FareType {
  FLAT_FARE    // Vé toàn tuyến đồng giá
  STAGE_FARE   // Vé chặng theo khoảng cách / cặp trạm
}

enum TicketType {
  SINGLE           // Vé lượt thường
  MONTHLY_STUDENT  // Vé tháng học sinh, sinh viên
  MONTHLY_REGULAR  // Vé tháng người lớn/thường
  PRIORITY         // Vé miễn giảm đối tượng ưu tiên
}

enum TripStatus {
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum TicketStatus {
  RESERVED
  BOOKED
  CANCELLED
}

model Route {
  id                   String        @id @default(uuid())
  code                 String        @unique // Mã số tuyến xe buýt (vd: "BUS-01", "T01")
  name                 String        // Tên tuyến (vd: "Bến xe Thái Nguyên - CNTT&TT")
  description          String?
  distanceKm           Float         @default(0.0)
  estimatedDurationMin Int           @default(0)
  status               RouteStatus   @default(DRAFT)
  deletedAt            DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  routeStops           RouteStop[]
  fares                Fare[]
  trips                Trip[]

  @@index([status])
  @@index([deletedAt])
  @@map("routes")
}

model BusStop {
  id          String      @id @default(uuid())
  code        String      @unique // Mã trạm (vd: "BS-101")
  name        String      // Tên trạm dừng
  address     String      // Địa chỉ trạm
  latitude    Float       // Vĩ độ
  longitude   Float       // Kinh độ
  isActive    Boolean     @default(true)
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  routeStops  RouteStop[]
  fromFares   Fare[]      @relation("FareFromStop")
  toFares     Fare[]      @relation("FareToStop")

  @@index([latitude, longitude])
  @@index([deletedAt])
  @@index([isActive])
  @@map("bus_stops")
}

model RouteStop {
  id                       String    @id @default(uuid())
  routeId                  String
  stopId                   String
  stopOrder               Int       // Thứ tự trạm trên tuyến (1, 2, 3...)
  distanceFromStartKm      Float     @default(0.0) // Khoảng cách tích lũy từ trạm xuất phát
  estimatedMinutesFromStart Int      @default(0)   // Thời gian di chuyển tích lũy
  isTerminal               Boolean   @default(false) // Trạm đầu hoặc trạm cuối

  route                    Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop                     BusStop   @relation(fields: [stopId], references: [id], onDelete: Restrict)

  @@unique([routeId, stopId], name: "unique_route_stop")
  @@unique([routeId, stopOrder], name: "unique_route_order")
  @@index([routeId])
  @@index([stopId])
  @@map("route_stops")
}

model Bus {
  id          String   @id @default(uuid())
  plateNumber String   @unique
  busType     String
  totalSeats  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trips       Trip[]

  @@map("buses")
}

model Trip {
  id            String     @id @default(uuid())
  routeId       String
  busId         String
  departureTime DateTime
  arrivalTime   DateTime
  status        TripStatus @default(SCHEDULED)
  basePrice     Float      @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  route         Route      @relation(fields: [routeId], references: [id], onDelete: Restrict)
  bus           Bus        @relation(fields: [busId], references: [id], onDelete: Restrict)
  bookings      Booking[]
  tickets       Ticket[]

  @@index([routeId, departureTime, status])
  @@index([status, departureTime])
  @@map("trips")
}

model Booking {
  id          String        @id @default(uuid())
  tripId      String
  bookingCode String        @unique
  status      BookingStatus @default(PENDING)
  totalAmount Float         @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  trip        Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tickets     Ticket[]

  @@index([tripId, status])
  @@map("bookings")
}

model Ticket {
  id         String       @id @default(uuid())
  bookingId  String
  tripId     String
  seatNumber String
  price      Float        @default(0)
  status     TicketStatus @default(RESERVED)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  booking    Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  trip       Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, status])
  @@map("tickets")
}

model Fare {
  id            String       @id @default(uuid())
  routeId       String
  fareType      FareType     @default(FLAT_FARE)
  ticketType    TicketType   @default(SINGLE)
  amount        Float        // Giá vé VND, phải > 0
  fromStopId    String?      // Bắt buộc nếu là STAGE_FARE
  toStopId      String?      // Bắt buộc nếu là STAGE_FARE
  effectiveFrom DateTime     @default(now())
  effectiveTo   DateTime?
  isActive      Boolean      @default(true)
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  route         Route        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  fromStop      BusStop?     @relation("FareFromStop", fields: [fromStopId], references: [id], onDelete: SetNull)
  toStop        BusStop?     @relation("FareToStop", fields: [toStopId], references: [id], onDelete: SetNull)

  @@index([routeId])
  @@index([fareType])
  @@index([deletedAt])
  @@map("fares")
}
