{
  "name": "backend",
  "version": "1.0.0",
  "description": "Smart Bus Ticketing System - Backend API",
  "author": "N5 Innovators",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.express.json",
    "start": "ts-node src/server.ts",
    "start:express": "ts-node src/server.ts",
    "start:prod": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "db:migrate": "node scripts/migrate-postgres.cjs",
    "test:postgres": "node scripts/test-postgres.cjs",
    "test:serverless": "node scripts/test-serverless.cjs",
    "db:create-admin": "node scripts/create-admin.cjs",
    "db:seed-seats": "node scripts/seed_seats.js",
    "db:seed-oct13": "node scripts/seed-trips-oct13.js",
    "test:oct13": "node scripts/test-oct13-trips.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "class-validator": "^0.14.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.1",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.1.0",
    "pg": "8.23.1",
    "qrcode": "^1.5.4",
    "redis": "^4.7.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "6.0.3",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^30.5.2",
    "prettier": "^3.2.5",
    "supertest": "7.3.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.service.ts",
      "!**/database/**"
    ],
    "coverageReporters": [
      "text",
      "text-summary",
      "json"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
