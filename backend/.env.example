# Copy Transaction pooler from Supabase > Connect. Never use a VITE_ prefix.
DATABASE_URL=postgresql://postgres.uhoznqcpaasartfvdynx:YOUR_ENCODED_PASSWORD@YOUR_POOLER_HOST:6543/postgres?sslmode=verify-full
# Migrations/import: session pooler (5432), or direct connection on IPv6.
DIRECT_URL=postgresql://postgres.uhoznqcpaasartfvdynx:YOUR_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=verify-full
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=86400
DB_POOL_MAX=2
PORT=5000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# Optional one-time import; omit when starting empty.
# MYSQL_SOURCE_URL=mysql://user:password@127.0.0.1:3308/smartbus_db
MYSQL_SOURCE_TIMEZONE=Asia/Ho_Chi_Minh
# Optional admin bootstrap for a new installation.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=your-strong-private-password
