# Copy Transaction pooler from Supabase > Connect. Never use a VITE_ prefix.
DATABASE_URL=postgresql://postgres.uhoznqcpaasartfvdynx:YOUR_ENCODED_PASSWORD@YOUR_POOLER_HOST:6543/postgres?sslmode=verify-full
# Migrations/import: session pooler (5432), or direct connection on IPv6.
DIRECT_URL=postgresql://postgres.uhoznqcpaasartfvdynx:YOUR_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=verify-full
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=86400
DB_POOL_MAX=2
PORT=5000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# Optional one-time import; omit when starting empty.
# MYSQL_SOURCE_URL=mysql://user:password@127.0.0.1:3308/smartbus_db
MYSQL_SOURCE_TIMEZONE=Asia/Ho_Chi_Minh
# Optional admin bootstrap for a new installation.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=your-strong-private-password

# Optional when running the API directly; Docker Compose supplies redis://redis:6379.
REDIS_URL=

# Sandbox payment gateways. Configure public HTTPS callbacks for external IPNs.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/api/v1/ticketing/payments/vnpay/return
VNPAY_REFUND_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_CREATE_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_IPN_URL=
MOMO_REFUND_URL=https://test-payment.momo.vn/v2/gateway/api/refund
PAYMENT_RESULT_URL=http://localhost:3000/passenger/booking
PAYMENT_CLIENT_IP=
PAYMENT_REFUND_OPERATOR=smartbus-system
PAYMENT_REFUND_IP=127.0.0.1
