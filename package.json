{
  "name": "smart-bus-ticketing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix backend run start:express",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "start": "npm --prefix backend run start:express",
    "lint": "npm --prefix backend run lint && npm --prefix frontend run lint",
    "test": "npm --prefix backend test -- --runInBand && npm --prefix frontend test"
  },
  "devDependencies": {
    "husky": "^8.0.3",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0"
  },
  "lint-staged": {
    "frontend/**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "backend/**/*.{js,ts}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
