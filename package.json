{
  "name": "smart-bus-ticketing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
   "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc",
    "start": "node dist/main.ts",
    "lint": "eslint \"src/**/*.{js,ts}\"",
    "test": "jest"
  },
  "devDependencies": {
    "husky": "^8.0.3",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0"
  },
  "lint-staged": {
    "frontend/**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "backend/**/*.{js,ts}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
