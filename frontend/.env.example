# Leave unset for Vercel: frontend and API share an origin.
# VITE_API_URL=http://localhost:5000

# Host cổng thanh toán production được phép chuyển hướng (ngoài sandbox VNPay/MoMo), phân tách bằng dấu phẩy.
# VITE_PAYMENT_GATEWAY_HOSTS=pay.vnpay.vn,payment.momo.vn

# Mặc định gọi Express API; chỉ đặt demo khi muốn chạy dữ liệu mô phỏng độc lập.
VITE_APP_MODE=api
VITE_API_BASE_URL=/api/smartbus/v1
VITE_LEGACY_APP=false

# Enable the existing seed account shortcuts only on a deployment used for testing.
# Development and demo mode already show the shortcuts.
VITE_ENABLE_QUICK_LOGIN=false

# Mặc định dùng nền OpenStreetMap France/HOT cho website đồ án công khai, phi thương mại.
# Khi dùng thương mại, cấu hình nhà cung cấp phù hợp qua hai biến bên dưới.
# VITE_MAP_TILE_URL=https://your-provider/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=Attribution required by provider
